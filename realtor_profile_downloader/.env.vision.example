# Gemini Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Windows scanner root. The app creates incoming, processed, review,
# failed, crops and reports underneath this folder.
REALTOR_PROFILE_ROOT=C:\RealtorProfileScanner
VISION_CROP_SCALE=2.0
VISION_POLL_SECONDS=30
KEEP_VISION_CROPS=false

# Google Sheets (optional when Supabase is configured)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\RealtorProfileScanner\service_account.json

# Supabase (optional when Google Sheets is configured)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=INFO
