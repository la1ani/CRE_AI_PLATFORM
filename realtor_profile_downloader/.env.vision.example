# Gemini Vision
GEMINI_API_KEY=
# Flash-Lite is designed for high-frequency extraction and supports images + structured output.
GEMINI_MODEL=gemini-2.5-flash-lite
# Comma-separated fallback models. The scanner tries these only if the primary model is unavailable
# or its model-specific quota has been exhausted.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Local Windows scanner root. The app creates incoming, processing, processed,
# review, failed, crops and reports underneath this folder.
REALTOR_PROFILE_ROOT=C:\RealtorProfileScanner
VISION_CROP_SCALE=2.0
VISION_POLL_SECONDS=30
KEEP_VISION_CROPS=false

# Google Sheets (optional when Supabase is configured)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\RealtorProfileScanner\service_account.json

# Supabase (optional when Google Sheets is configured)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=INFO
