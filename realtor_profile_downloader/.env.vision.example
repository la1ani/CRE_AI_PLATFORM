# Gemini Vision
GEMINI_API_KEY=
# Current low-cost multimodal model for high-frequency extraction.
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated fallbacks. The scanner first checks which models this API project exposes.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Local Windows scanner root. The app creates incoming, processing, processed,
# review, failed, crops and reports underneath this folder.
REALTOR_PROFILE_ROOT=C:\RealtorProfileScanner
VISION_CROP_SCALE=2.0
VISION_POLL_SECONDS=30
KEEP_VISION_CROPS=false

# Google Sheets (optional). Share the spreadsheet with the service account's client_email.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\RealtorProfileScanner\service_account.json

# Supabase (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=INFO
